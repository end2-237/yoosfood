# ─── Camille ─────────────────────────────────────────────────────────────────
# YoosFood est un client de l'API Camille : catalogue en lecture, commandes en
# écriture. Les clés se génèrent depuis le tableau de bord Camille.

# URL de l'instance Camille
NEXT_PUBLIC_CAMILLE_URL=https://camille.vps.buyticle.com

# Clé PUBLIQUE (cam_pk_…) — lecture du catalogue, exposée au navigateur.
NEXT_PUBLIC_CAMILLE_PUBLIC_KEY=cam_pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé SECRÈTE (cam_sk_…) — création de commandes. SERVEUR UNIQUEMENT :
# elle ne doit jamais apparaître dans une variable NEXT_PUBLIC_*.
CAMILLE_SECRET_KEY=cam_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
